{
  "openapi": "3.1.0",
  "info": {
    "title": "AWEFonts Static API",
    "version": "3.0.0",
    "description": "Static typography API: 2,235 families, 103,073 provider-specific font resources, 1,404 language codes and 172 writing systems."
  },
  "servers": [
    {
      "url": "https://fonts.api.aweconnect.dpdns.org",
      "description": "AWEFonts static API"
    }
  ],
  "paths": {
    "/v1/catalog.json": {
      "get": {
        "summary": "Get worldwide font catalog",
        "responses": {
          "200": {
            "description": "Font catalog JSON"
          }
        }
      }
    },
    "/v1/embed.js": {
      "get": {
        "summary": "Versioned browser embed loader",
        "responses": {
          "200": {
            "description": "JavaScript embed loader"
          }
        }
      }
    },
    "/v1/health.json": {
      "get": {
        "summary": "API metadata",
        "responses": {
          "200": {
            "description": "Static API health information"
          }
        }
      }
    },
    "/v1/embed.v2.js": {
      "get": {
        "summary": "Versioned browser embed loader (recommended)",
        "responses": {
          "200": {
            "description": "JavaScript embed loader"
          }
        }
      }
    },
    "/v1/embed.v3.js": {
      "get": {
        "summary": "Versioned browser embed loader (recommended)",
        "responses": {
          "200": {
            "description": "JavaScript embed loader"
          }
        }
      }
    },
    "/v1/embed.v4.js": {
      "get": {
        "summary": "Configurable multilingual font embed loader",
        "responses": {
          "200": {
            "description": "JavaScript embed loader with selector and typography controls"
          }
        }
      }
    },
    "/v1/sources.json": {
      "get": {
        "summary": "List global font source platforms and mirror eligibility",
        "responses": {
          "200": {
            "description": "Global source directory JSON"
          }
        }
      }
    },
    "/v1/assets-index.json": {
      "get": {
        "summary": "Get the 100k+ font resource index and shard manifest",
        "responses": {
          "200": {
            "description": "Static asset index JSON"
          }
        }
      }
    },
    "/v1/assets/{shard}.json": {
      "get": {
        "summary": "Get a font resource shard",
        "responses": {
          "200": {
            "description": "Font resource shard JSON"
          }
        }
      }
    },
    "/v1/languages.json": {
      "get": {
        "summary": "Get language and script profiles",
        "responses": {
          "200": {
            "description": "Language profiles JSON"
          }
        }
      }
    }
  }
}