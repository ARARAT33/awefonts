{
  "openapi": "3.1.0",
  "info": {
    "title": "AWEFonts Static API",
    "version": "1.2.0",
    "description": "Static font catalog, API-hosted per-family CSS endpoints, and browser embed loader. Font binaries remain delivered by their licensed upstream providers."
  },
  "servers": [
    {
      "url": "https://fonts.api.aweconnect.dpdns.org"
    }
  ],
  "paths": {
    "/v1/catalog.json": {
      "get": {
        "summary": "Get worldwide font catalog",
        "responses": {
          "200": {
            "description": "Font catalog JSON"
          }
        }
      }
    },
    "/v1/embed.js": {
      "get": {
        "summary": "Versioned browser embed loader",
        "responses": {
          "200": {
            "description": "JavaScript embed loader"
          }
        }
      }
    },
    "/v1/health.json": {
      "get": {
        "summary": "API metadata",
        "responses": {
          "200": {
            "description": "Static API health information"
          }
        }
      }
    },
    "/v1/embed.v2.js": {
      "get": {
        "summary": "Versioned browser embed loader (recommended)",
        "responses": {
          "200": {
            "description": "JavaScript embed loader"
          }
        }
      }
    },
    "/v1/embed.v3.js": {
      "get": {
        "summary": "Versioned browser embed loader (recommended)",
        "responses": {
          "200": {
            "description": "JavaScript embed loader"
          }
        }
      }
    },
    "/v1/embed.v4.js": {
      "get": {
        "summary": "Configurable multilingual font embed loader",
        "responses": {
          "200": {
            "description": "JavaScript embed loader with selector and typography controls"
          }
        }
      }
    },
    "/v1/sources.json": {
      "get": {
        "summary": "List global font source platforms and mirror eligibility",
        "responses": {
          "200": {
            "description": "Global source directory JSON"
          }
        }
      }
    },
    "/v1/embed.v6.js": {
      "get": {
        "summary": "API-hosted CSS browser embed loader",
        "responses": {
          "200": {
            "description": "JavaScript embed loader"
          }
        }
      }
    },
    "/v1/css/{font_id}.css": {
      "get": {
        "summary": "API-hosted stylesheet for a catalog font family",
        "parameters": [
          {
            "name": "font_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSS stylesheet that loads the font from its licensed upstream provider"
          }
        }
      }
    }
  }
}